      "style": "width:1.9407198306280877%;height:3.9568345323741005%;left:90.93154551870148%;top:11.870503597122301%;border-color:#FB923Cbf",
      "round": true
     }
    ],
    "file": "assets/guides/p-l-guide-in-intacct-dms-only/step-08.jpeg",
